#!/bin/bash
#PBS -N characteristic_curves_bgk
#PBS -l select=1:ncpus=8:ngpus=1:mem=128gb:gpu_type=A100
#PBS -l walltime=72:00:00
#PBS -o /dev/null
#PBS -e /dev/null

PROJECT_ROOT=/gpfs/home/cw1722/sponge/JAX-LaB
OUTPUT_DIR="${PROJECT_ROOT}/results/characteristic_curves_bgk"
LOG="${OUTPUT_DIR}/run.log"

# ── Output directory ──────────────────────────────────────────────────────────
mkdir -p "${OUTPUT_DIR}"
mkdir -p "${OUTPUT_DIR}/images"

# Redirect all stdout and stderr through tee so output is written to run.log
# in real time while still flowing to the PBS stdout stream.
exec > >(tee -a "${LOG}") 2>&1

# Symlink the geometry assets folder into the output directory so that the
# relative path ./assets/374_05_03_256.mat used in characteristic_curves.py
# resolves correctly when the working directory is results/characteristic_curves_bgk/.
ln -sfn "${PROJECT_ROOT}/assets" "${OUTPUT_DIR}/assets"

# ── Environment ───────────────────────────────────────────────────────────────
# Activate the uv-managed virtual environment (jax-lab, Python 3.10)
source "${PROJECT_ROOT}/.venv/bin/activate"

# Expose the src/ package to the Python import system
export PYTHONPATH="${PROJECT_ROOT}"

# ── Run ───────────────────────────────────────────────────────────────────────
# Change into the output directory so that all relative paths produced by the
# script land here:
#   - VTK field files      → results/characteristic_curves_bgk/output_<r>/  and  output_imbibition/  output_drainage/
#   - PhantomGaze renders  → results/characteristic_curves_bgk/images/
#   - Saturation curves    → results/characteristic_curves_bgk/surface_tension.txt
#                            results/characteristic_curves_bgk/characteristic_curve_imbibition.txt
#                            results/characteristic_curves_bgk/characteristic_curve_drainage.txt
#   - Geometry asset       → results/characteristic_curves_bgk/assets/374_05_03_256.mat  (via symlink)
cd "${OUTPUT_DIR}"

echo "Job started at:  $(date)"
echo "Host:            $(hostname)"
echo "GPU(s):          ${CUDA_VISIBLE_DEVICES}"
echo "Python:          $(python3 --version)"
echo "Working dir:     $(pwd)"
echo "================================================================================"

python3 -u "${PROJECT_ROOT}/examples/multiphase/BGK/characteristic_curves.py"

echo "================================================================================"
echo "Job finished at: $(date)"
